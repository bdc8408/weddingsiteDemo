# Prevent caching of the main HTML page so users always get the latest build
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Vite hashes JS/CSS assets — safe to cache aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
